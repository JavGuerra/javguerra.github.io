---
import type { GetStaticPathsOptions, Page } from 'astro';
import SearchBox from '@/components/SearchBox.astro';
import '@/styles/pagefind-ui-custom.css';
import siteConfig from '@/siteConfig.json';
import { getSortedPostsData } from '@/scripts/postsUtils';
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import ButtonLink from '@/components/ButtonLink.astro';
import Card from '@/components/Card.astro';

interface Props {
    page: Page<Awaited<ReturnType<typeof getSortedPostsData>>[number]>;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const sortedPosts = await getSortedPostsData();
    return paginate(sortedPosts, { pageSize: siteConfig.pageSize });
}

const { page } = Astro.props;
---

<BaseLayout pageTitle="Blog" subTitle="Mis aprendizajes">

  <h2 class="mt-2 mb-6">Entradas</h2>

  <SearchBox />

  {page.data.length ? (
    <ul class="list-none p-0">
      {page.data.map(post => (
        <li class="my-8 text-center md:text-left">
          <BlogPostCard
            frontmatter={post.frontmatter}
            href={post.href}
            firstParagraph={post.firstParagraph}
          />
        </li>
      ))}
    </ul>

    <section class="mt-8 mb-14 flex justify-between items-center gap-3">
      <ButtonLink
        href={page.url.prev ? page.url.prev : "#"}
        text="←&nbsp;Anterior"
      />

      <span class="gray text-center">
        <small>
          Página {page.currentPage}&nbsp;de&nbsp;{page.lastPage}
        </small>
      </span>

      <span class="mt-2">
        <ButtonLink
          href={page.url.next ? page.url.next : "#"}
          text="Siguiente&nbsp;→"
        />
      </span>
    </section>

  ) : (

    <span class="inline-block w-full my-4 pt-2 pb-4 px-4 border-s-4 bg-violet-200 dark:bg-violet-800 border-orange-600 dark:border-orange-400 text-violet-900 dark:text-violet-100">
      Aún no hay entradas en este blog.
    </span>
  )}

  <div class="my-8">
    <ul>
      <Card href="/temas" title="Lista de temas">
        Accede a la lista de temas de interés etiquetados en el blog y a mis enlaces recomendados.
      </Card>
    </ul>
  </div>

</BaseLayout>