<div id="slideshow" class="w-full font-serif">
  <div id="slideshow-container"></div>
</div>

<script>
  import recommendations from '@/content/_recommendations.json';
  import '@/styles/carousel.css';

  interface Recommendation {
    text: string;
    author: string;
    role: string;
  }

  const DURATION_SECONDS = 9;
  let slides: Recommendation[] = [];

  let timeoutId: ReturnType<typeof setTimeout> | null = null;
  let currentIndex = 0;

  const shuffleArray = <T,>(array: T[]): T[] => {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  };

  function createSlide(recommendation: Recommendation) {
    const slide = document.createElement('div');
    slide.className = 'content-slide';

    slide.innerHTML = `
      <p class="quote-text">«${recommendation.text}»</p>
      <p class="quote-author gray">— <strong>${recommendation.author}</strong>, ${recommendation.role}</p>
    `;

    return slide;
  }

  function updateSlide() {
    const container = document.getElementById('slideshow-container');
    if (!container || slides.length === 0) return;

    const newSlide = createSlide(slides[currentIndex]);
    container.appendChild(newSlide);
    void newSlide.offsetWidth;
    newSlide.classList.add('animating');

    currentIndex = (currentIndex + 1) % slides.length;

    timeoutId = setTimeout(() => {
      newSlide.remove();
      updateSlide();
    }, DURATION_SECONDS * 1000);
  }

  function startCarousel() {
    const container = document.getElementById('slideshow-container');
    if (!container || recommendations.length === 0) return;

    if (timeoutId !== null) {
      clearTimeout(timeoutId);
      timeoutId = null;
    }

    container.replaceChildren();
    slides = shuffleArray(recommendations);
    currentIndex = 0;
    updateSlide();
  }

  function stopCarousel() {
    if (timeoutId !== null) {
      clearTimeout(timeoutId);
      timeoutId = null;
    }

    const container = document.getElementById('slideshow-container');
    if (container) container.replaceChildren();
  }

  document.addEventListener('astro:before-preparation', stopCarousel);
  document.addEventListener('astro:page-load', startCarousel);
</script>