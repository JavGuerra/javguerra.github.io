<style>
  #slideshow-container {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  /* :global() le dice a Astro que no le añada el hash de scoping a esta clase */
  :global(.content-slide) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  @keyframes slideInOut {
    0% { transform: translateX(100%); }
    11.11%, 88.89% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  :global(.animating) {
    animation: slideInOut 9s linear;
  }
</style>

<div id="slideshow" class="w-full font-serif">
  <div id="slideshow-container" class="p-4 mt-0 mb-8" style="height: 160px;"></div>
</div>

<script>
  import recommendations from '@/content/_recommendations.json';

  const DURATION_SECONDS = 9;
  const slides = recommendations.map((slide) => slide.quote);

  let timeoutId: ReturnType<typeof setTimeout> | null = null;
  let currentIndex = 0;

  const shuffleArray = <T,>(array: T[]): T[] => {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
  };

  function createSlide(content: string) {
    const slide = document.createElement('div');
    slide.className = 'content-slide';
    slide.innerHTML = content;
    return slide;
  }

  function updateSlide() {
    const container = document.getElementById('slideshow-container');
    if (!container || slides.length === 0) return;

    const newSlide = createSlide(slides[currentIndex]);
    container.appendChild(newSlide);
    void newSlide.offsetWidth;
    newSlide.classList.add('animating');

    currentIndex = (currentIndex + 1) % slides.length;

    timeoutId = setTimeout(() => {
      newSlide.remove();
      updateSlide();
    }, DURATION_SECONDS * 1000);
  }

  function startCarousel() {
    const container = document.getElementById('slideshow-container');
    if (!container || slides.length === 0) return;

    if (timeoutId !== null) {
      clearTimeout(timeoutId);
      timeoutId = null;
    }

    container.replaceChildren();
    shuffleArray(slides);
    currentIndex = 0;
    updateSlide();
  }

  function stopCarousel() {
    if (timeoutId !== null) {
      clearTimeout(timeoutId);
      timeoutId = null;
    }

    const container = document.getElementById('slideshow-container');
    if (container) container.replaceChildren();
  }

  document.addEventListener('astro:before-preparation', stopCarousel);
  document.addEventListener('astro:page-load', startCarousel);
</script>