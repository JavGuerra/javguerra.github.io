---
import { getSortedPostsData } from '@/scripts/postsUtils';
import BlogPostCard from "@/components/BlogPostCard.astro";

const sortedPosts = await getSortedPostsData({
    includeFirstParagraph: false
});
---

<ul class="my-8 text-center md:text-left">
    {sortedPosts && sortedPosts.map((post, index) => (
        <div
            class={index === 0 ? '' : 'hidden'}
            data-post-index={index}
        >
        <BlogPostCard
            frontmatter={post.frontmatter}
            href={post.href}
            ignorePrefetch={true}
        />
        </div>
    ))}
</ul>

<script is:inline>
    let interval = null;
    let currentIndex = 0;
    let isTransitioning = false;

    function handleContentLoaded() {
        const postContainers = document.querySelectorAll('[data-post-index]');

        if (postContainers.length <= 1) return;

        if (interval !== null) {
            clearInterval(interval);
            interval = null;
        }

        currentIndex = 0;
        isTransitioning = false;

        postContainers.forEach((post, index) => {
            post.classList.toggle('hidden', index !== 0);
            post.classList.remove('fade-out');
        });

        function showRandomPost() {
            if (isTransitioning) return;

            let randomIndex = Math.floor(
                Math.random() * postContainers.length
            );

            while (randomIndex === currentIndex) {
                randomIndex = Math.floor(
                    Math.random() * postContainers.length
                );
            }

            const actual = postContainers[currentIndex];
            const next = postContainers[randomIndex];

            if (!actual || !next) return;

            isTransitioning = true;
            actual.classList.add('fade-out');

            actual.addEventListener('transitionend', function fadeOutHandler() {
                actual.classList.add('hidden');
                actual.classList.remove('fade-out');
                next.classList.remove('hidden');
                currentIndex = randomIndex;
                isTransitioning = false;
            }, { once: true });
        }

        interval = setInterval(showRandomPost, 7000);
    }

    function cleanup() {
        if (interval !== null) {
            clearInterval(interval);
            interval = null;
        }

        currentIndex = 0;
        isTransitioning = false;

        const postContainers = document.querySelectorAll('[data-post-index]');

        postContainers.forEach((post, index) => {
            post.classList.toggle('hidden', index !== 0);
            post.classList.remove('fade-out');
        });
    }

    document.addEventListener('astro:page-load', handleContentLoaded);
    document.addEventListener('astro:before-preparation', cleanup);

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            cleanup();
        } else {
            handleContentLoaded();
        }
    });
</script>

<style>
    .fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-out;
    }
</style>