---
import type { ImageMetadata } from 'astro';
import { Image } from "astro:assets";

interface Props {
  href: string;
  img: ImageMetadata;
  alt: string;
  styles?: string;
  title?: string;
  transitionName?: boolean;
}

const {
  href,
  img,
  alt,
  styles,
  title = alt,
  transitionName = true
} = Astro.props;
---

<li class="post-card scroll-reveal">
  <a href={href} role="button" aria-label={title} data-astro-prefetch>

    <div class="md:flex md:items-center">

      <Image
        src={img}
        alt={alt}
        loading="lazy"
        class={styles}
        transition:name={transitionName ? href : undefined}
      />

      <div class="md:ms-8 md:w-full text-center md:text-left">
        <slot />
      </div>

    </div>

  </a>
</li>