---
import { getNewPost } from '@/scripts/postsUtils';
import BlogPostCard from "@/components/BlogPostCard.astro";

const newPost = await getNewPost();
---

{newPost && 

  <ul class="my-8 text-center md:text-left">

    <BlogPostCard
      frontmatter={newPost.frontmatter}
      href={newPost.href}
      firstParagraph={newPost.firstParagraph}
    />

  </ul>

}