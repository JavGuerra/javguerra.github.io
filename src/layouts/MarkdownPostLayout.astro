---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import '@/styles/markdown.css';
import { Image } from 'astro:assets';
import siteConfig from '@/siteConfig.json';
import BaseLayout from './BaseLayout.astro';
import TagLabel from '@/components/TagLabel.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Disqus from '@/components/Disqus.astro';

interface Props {
    frontmatter: CollectionEntry<'posts'>['data'];
    id: string;
}

const { 
  id, 
  frontmatter: {
    route,
    title,
    description,
    author,
    pubDate,
    updatedDate = pubDate,
    coverImage,
    tags,
    info
  } 
} = Astro.props;
---

<BaseLayout pageTitle={title} subTitle={description} coverImage={coverImage}>

    <p class="-mt-6 mb-2 gray"><small>
        {author ? author : siteConfig.autor}{
            pubDate && <>, <FormattedDate date={pubDate} /></>}
    </small></p>

    {coverImage && <Image src={coverImage.image as ImageMetadata} title={coverImage.alt}
        alt={coverImage.alt} class="my-8" loading="eager" transition:name={`/blog/${route}`} />}

    <div data-pagefind-ignore="all">
        <div class="flex flex-wrap mt-4">
            {tags && tags.map((tag: string) => ( <TagLabel tag={tag} /> ))}
        </div>
    </div>

    <div class="my-8 md-content">
        <slot />
    </div>

    <Disqus id={id} />

    <div class="text-center mt-8 md:text-left">
        <ButtonLink text="←&nbsp;Volver" />
    </div>
</BaseLayout>