---
import type { CollectionEntry } from 'astro:content';
import '@/styles/base.css';
import siteConfig from '@/siteConfig.json';
import BaseHead from '@/components/BaseHead.astro';
import MenuBar from '@/components/MenuBar.astro';
import Footer from '@/components/Footer.astro';
import { getImage } from 'astro:assets';

interface Props {
    pageTitle: string;
    subTitle?: string;
    // Permite el tipo nativo de la colección o un objeto con rutas de texto
    coverImage?: CollectionEntry<'posts'>['data']['coverImage'] | Record<string, string>;
}

const disqusShortname = 'codice-1';
const { pageTitle, subTitle, coverImage } = Astro.props;
const showTitle = pageTitle != 'Error 404';
const shouldIgnore = pageTitle.startsWith('«') || pageTitle === 'Blog';
const description = subTitle ? subTitle : siteConfig.description;
let routeImage = '/assets/img/banner.png';

if (coverImage?.image) {
    // getImage procesa automáticamente la imagen
    const processedImage = await getImage({ src: coverImage.image as any });
    routeImage = processedImage.src;
}
---

<html lang="es">

  <BaseHead pageTitle={pageTitle} description={description} img={routeImage} />

  <body data-pagefind-ignore={shouldIgnore ? '' : null}>

    <MenuBar title={pageTitle} />

    <header transition:animate="slide">
      {showTitle && <h1>{pageTitle}</h1>}
      {subTitle && <p class="subtitle">{subTitle}</p>}
    </header>

    <main class="my-8">
      <slot />
    </main>

    <Footer />

    <script
      id="dsq-count-scr"
      src={'//' + disqusShortname + '.disqus.com/count.js'}
      async
      is:inline
    ></script>

  </body>

</html>