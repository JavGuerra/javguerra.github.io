{
  "name": "javguerra-github-io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",

    "check:types": "astro check",
    "check:links": "lychee --root-dir ./dist --offline \"dist/**/*.html\"",
    "check:links:full": "lychee --root-dir ./dist --insecure --accept 200..=299,403,429 --max-concurrency 4 --user-agent \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" --exclude '(youtube\\.com|linkedin\\.com|twitter\\.com|x\\.com|filmaffinity\\.com|javguerra\\.github\\.io/404)' \"dist/**/*.html\"",
    
    "build": "astro build",
    "build:check": "npm run check:types && npm run build && npm run check:links",
    "build:check:full": "npm run check:types && npm run build && npm run check:links:full",
    "preview": "astro preview",

    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "astro-pagefind": "^1.8.6"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.68.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "postcss": "^8.5.26",
    "postcss-html": "^1.7.0",
    "stylelint-config-html": "^1.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@astrojs/tailwind": {
      "astro": "$astro"
    },
    "astro-pagefind": {
      "astro": "$astro"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
